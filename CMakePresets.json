{
	"version": 10,
	"cmakeMinimumRequired": {
		"major": 4,
		"minor": 0,
		"patch": 0
	},
	"$comment": "The default HSGIL CMakePresets.json file",
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"installDir": "${sourceDir}/out/install/${presetName}"
		},
		{
			"name": "base-win32",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "base-linux",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			}
		},
		{
			"name": "debug",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "release",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "x64",
			"hidden": true,
			"architecture": {
				"value": "x64",
				"strategy": "external"
			}
		},
		{
			"name": "x86",
			"hidden": true,
			"architecture": {
				"value": "x86",
				"strategy": "external"
			}
		},
		{
			"name": "x64-debug-win32",
			"displayName": "x64 Debug",
			"description": "Sets debug build type and x64 arch",
			"inherits": [ "base-win32", "debug", "x64" ]
		},
		{
			"name": "x86-debug-win32",
			"displayName": "x86 Debug",
			"description": "Sets debug build type and x86 arch",
			"inherits": [ "base-win32", "debug", "x86" ]
		},
		{
			"name": "x64-release-win32",
			"displayName": "x64 Release",
			"description": "Sets release build type and x64 arch",
			"inherits": [ "base-win32", "release", "x64" ]
		},
		{
			"name": "x86-release-win32",
			"displayName": "x86 Release",
			"description": "Sets release build type and x86 arch",
			"inherits": [ "base-win32", "release", "x86" ]
		},
		{
			"name": "x64-debug-linux",
			"displayName": "x64 Debug",
			"description": "Sets debug build type and x64 arch",
			"inherits": [ "base-linux", "debug", "x64" ]
		},
		{
			"name": "x86-debug-linux",
			"displayName": "x86 Debug",
			"description": "Sets debug build type and x86 arch",
			"inherits": [ "base-linux", "debug", "x86" ]
		},
		{
			"name": "x64-release-linux",
			"displayName": "x64 Release",
			"description": "Sets release build type and x64 arch",
			"inherits": [ "base-linux", "release", "x64" ]
		},
		{
			"name": "x86-release-linux",
			"displayName": "x86 Release",
			"description": "Sets release build type and x86 arch",
			"inherits": [ "base-linux", "release", "x86" ]
		}
	],
	"buildPresets": [
		{
			"name": "default-build-win32",
			"displayName": "Default",
			"description": "Vanilla build",
			"configurePreset": "x64-debug-win32"
		},
		{
			"name": "default-build-linux",
			"displayName": "Default",
			"description": "Vanilla build",
			"configurePreset": "x64-debug-linux"
		},
		{
			"name": "verbose-build-win32",
			"displayName": "Verbose Build",
			"configurePreset": "x64-debug-win32",
			"verbose": true
		},
		{
			"name": "verbose-build-linux",
			"displayName": "Verbose Build",
			"configurePreset": "x64-debug-linux",
			"verbose": true
		}
	],
	"testPresets": [
		{
			"name": "core-test-win32",
			"configurePreset": "x64-debug-win32",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "core-test-linux",
			"configurePreset": "x64-debug-linux",
			"output": {
				"outputOnFailure": true
			}
		}
	]
}
